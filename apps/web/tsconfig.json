{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@notarity-lens/shared": ["../../packages/shared/src/index.ts"],
      "@notarity-lens/notarity": ["../../packages/notarity/src/index.ts"],
      "@notarity-lens/ai": ["../../packages/ai/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
